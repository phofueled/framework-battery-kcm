[Unit]
Description=Framework battery control D-Bus service
After=polkit.service

[Service]
Type=dbus
BusName=org.frameworkbattery.Control1
ExecStart=/usr/lib/framework-battery/framework-battery-helper serve
User=root
StateDirectory=framework-battery
StateDirectoryMode=0700
RuntimeDirectory=framework-battery
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Restart=on-failure
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/systemd/system
PrivateTmp=true
