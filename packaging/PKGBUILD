# Local source package for CachyOS and Arch Linux.
# Run ./make-source.sh, then makepkg -si from this directory.
pkgname=framework-battery-kcm
pkgver=0.3.1
pkgrel=1
pkgdesc='Minimal Framework battery settings pane for KDE Plasma'
arch=('x86_64')
url='https://github.com/phofueled/framework-battery-kcm'
license=('BSD-3-Clause')
depends=('kcmutils' 'kirigami' 'polkit' 'qt6-declarative' 'systemd')
makedepends=('cargo' 'cmake' 'extra-cmake-modules' 'gcc' 'pkgconf')
source=("framework-battery-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/framework-battery-${pkgver}"
    export CARGO_HOME="${CARGO_HOME:-$srcdir/cargo-home}"
    RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-C opt-level=z" cargo build --release --locked
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

check() {
    cd "$srcdir/framework-battery-${pkgver}"
    cargo test --locked
    ctest --test-dir build --output-on-failure
}

package() {
    cd "$srcdir/framework-battery-${pkgver}"
    DESTDIR="$pkgdir" cmake --install build
    install -Dm755 target/release/framework-battery-helper \
        "$pkgdir/usr/lib/framework-battery/framework-battery-helper"
    install -Dm644 packaging/org.frameworkbattery.Control1.service \
        "$pkgdir/usr/share/dbus-1/system-services/org.frameworkbattery.Control1.service"
    install -Dm644 packaging/org.frameworkbattery.Control1.conf \
        "$pkgdir/usr/share/dbus-1/system.d/org.frameworkbattery.Control1.conf"
    install -Dm644 packaging/org.frameworkbattery.policy \
        "$pkgdir/usr/share/polkit-1/actions/org.frameworkbattery.policy"
    install -Dm644 packaging/framework-battery-dbus.service \
        "$pkgdir/usr/lib/systemd/system/framework-battery-dbus.service"
    install -Dm644 packaging/framework-battery-schedule.service \
        "$pkgdir/usr/lib/systemd/system/framework-battery-schedule.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
