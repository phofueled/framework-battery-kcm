[Unit]
Description=Apply the Framework battery charge schedule
ConditionPathExists=/var/lib/framework-battery/schedule.json

[Service]
Type=oneshot
ExecStart=/usr/lib/framework-battery/framework-battery-helper apply-schedule
User=root
StateDirectory=framework-battery
StateDirectoryMode=0700
RuntimeDirectory=framework-battery
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
